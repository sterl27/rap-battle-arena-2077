# Gemini (cloud fallback)
GEMINI_API_KEY=your_gemini_key

# MUSAIX local relay (voice_relay.py on Sterl's PC)
# Option A, Vite proxy (no relay change):   VITE_MUSAIX_RELAY_URL=/musaix
# Option B, direct + relay CORS allowlist:  VITE_MUSAIX_RELAY_URL=http://127.0.0.1:8765
VITE_MUSAIX_RELAY_URL=/musaix
# 'off' forces Gemini + the WebAudio beat
VITE_MUSAIX_LOCAL=on
VITE_MUSAIX_LLM_TIMEOUT_MS=20000
# MIDI track indexes in the Live set (relay get_snapshot) for beat_push
VITE_MUSAIX_DRUMS_TRACK=0
VITE_MUSAIX_BASS_TRACK=1
